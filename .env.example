# Copy to .env and fill in. Values below are for local development.

# --- Database ---------------------------------------------------------------
# MongoDB Atlas: Connect > Drivers, then add the database name before the "?":
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/khunmaeju?retryWrites=true&w=majority
# Self-hosted (docker compose --profile local-db): mongodb://127.0.0.1:27017/khunmaeju?directConnection=true
DATABASE_URL=

# --- App --------------------------------------------------------------------
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me
# Public URL of the site (no trailing slash). Production: https://www.khunmaejuphuket.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Media storage (optional) ------------------------------------------------
# Leave S3_BUCKET empty to store uploads on local disk (./media).
# Cloudflare R2 example: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Email (optional) --------------------------------------------------------
# Without SMTP_HOST, emails are only printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@khunmaejuphuket.com
SMTP_FROM_NAME=คุณแม่จู้ภูเก็ต
# Where contact-form notifications go (overrides the admin setting)
CONTACT_NOTIFY_EMAIL=

# --- Seed (dev only) --------------------------------------------------------
SEED_ADMIN_EMAIL=admin@khunmaeju.test
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=editor@khunmaeju.test
SEED_EDITOR_PASSWORD=

# --- Dev only --------------------------------------------------------------
# true = front end reads fake data from src/fixtures (no database needed). Ignored in production.
USE_FIXTURES=false
